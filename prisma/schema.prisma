generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  phone         String?
  password      String?
  role          String    @default("BUYER")
  companyId     String?
  avatar        String?
  walletAddress String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  company         Company?     @relation("CompanyOwner")
  properties      Property[]   @relation("PropertyOwner")
  leads           Lead[]       @relation("AgentLeads")
  investments     Investment[]
  unitBuyers      Unit[]       @relation("UnitBuyer")
  landlordLeases  Lease[]      @relation("LandlordLeases")
  tenantLeases    Lease[]      @relation("TenantLeases")

  @@map("users")
}

model Company {
  id         String    @id @default(cuid())
  ownerId    String    @unique
  name       String
  type       String
  city       String
  totalUnits Int       @default(0)
  logo       String?
  createdAt  DateTime  @default(now())

  owner    User      @relation("CompanyOwner", fields: [ownerId], references: [id])
  projects Project[]

  @@map("companies")
}

model Property {
  id             String   @id @default(cuid())
  ownerId        String
  title          String
  location       String
  city           String
  state          String
  lat            Float?
  lng            Float?
  propertyType   String
  bedrooms       Int?
  bathrooms      Int?
  sqm            Float?
  currentValue   BigInt?
  listingStatus  String   @default("ACTIVE")
  listingType    String   @default("BUY")
  price          BigInt
  roiPercent     Float?
  uosScore       Int?     @default(50)
  images         String   @default("[]")
  features       String   @default("[]")
  description    String?
  yearBuilt      Int?
  nftTokenId     String?
  txHash         String?
  metadataURI    String?
  ownerWallet    String?
  fractionalAddr String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner        User          @relation("PropertyOwner", fields: [ownerId], references: [id])
  tenants      Tenant[]
  payments     Payment[]
  bookings     Booking[]
  improvements Improvement[]
  valuations   Valuation[]
  leads        Lead[]
  leases       Lease[]

  @@map("properties")
}

model Tenant {
  id         String   @id @default(cuid())
  propertyId String
  landlordId String
  name       String
  email      String
  phone      String?
  rentAmount BigInt
  leaseStart DateTime
  leaseEnd   DateTime
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())

  property Property  @relation(fields: [propertyId], references: [id])
  payments Payment[]

  @@map("tenants")
}

model Payment {
  id         String    @id @default(cuid())
  propertyId String
  tenantId   String?
  amount     BigInt
  type       String    @default("RENT")
  dueDate    DateTime
  paidDate   DateTime?
  status     String    @default("PENDING")
  txHash     String?
  createdAt  DateTime  @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  tenant   Tenant?  @relation(fields: [tenantId], references: [id])

  @@map("payments")
}

model Booking {
  id             String   @id @default(cuid())
  propertyId     String
  guestName      String
  guestEmail     String
  guestPhone     String?
  checkin        DateTime
  checkout       DateTime
  nights         Int
  totalPrice     BigInt
  reference      String   @unique
  status         String   @default("PENDING")
  bookingIdChain String?
  escrowTxHash   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id])

  @@map("bookings")
}

model Lead {
  id         String   @id @default(cuid())
  propertyId String?
  agentId    String?
  name       String
  email      String
  phone      String?
  message    String?
  status     String   @default("NEW")
  source     String?
  unitId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property? @relation(fields: [propertyId], references: [id])
  agent    User?     @relation("AgentLeads", fields: [agentId], references: [id])

  @@map("leads")
}

model Valuation {
  id             String   @id @default(cuid())
  propertyId     String
  estimatedValue BigInt
  confidence     Int
  aiReport       String?
  createdAt      DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])

  @@map("valuations")
}

model Improvement {
  id          String   @id @default(cuid())
  propertyId  String
  type        String
  cost        BigInt
  valueImpact BigInt
  status      String   @default("RECOMMENDED")
  txHash      String?
  createdAt   DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])

  @@map("improvements")
}

model Neighborhood {
  id           String   @id @default(cuid())
  name         String
  city         String
  avgPriceSqm  BigInt
  rentalYield  Float
  growthRate   Float
  demandScore  Int
  safetyIndex  Int
  schoolRating Int
  createdAt    DateTime @default(now())

  @@map("neighborhoods")
}

model Project {
  id              String    @id @default(cuid())
  companyId       String
  name            String
  location        String
  totalUnits      Int
  soldUnits       Int       @default(0)
  availableUnits  Int
  reservedUnits   Int       @default(0)
  launchDate      DateTime?
  completionDate  DateTime?
  priceFrom       BigInt
  priceTo         BigInt
  status          String    @default("PLANNING")
  constructionPct Int       @default(0)
  createdAt       DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id])
  units   Unit[]

  @@map("projects")
}

model Unit {
  id         String   @id @default(cuid())
  projectId  String
  unitNumber String
  floor      Int
  type       String
  bedrooms   Int
  bathrooms  Int
  sqm        Float
  price      BigInt
  status     String   @default("AVAILABLE")
  buyerId    String?
  agentId    String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  buyer   User?   @relation("UnitBuyer", fields: [buyerId], references: [id])

  @@map("units")
}

model Investment {
  id          String   @id @default(cuid())
  investorId  String
  poolAddress String?
  propertyId  String?
  usdcAmount  BigInt?
  poolTokens  BigInt?
  txHash      String?
  createdAt   DateTime @default(now())

  investor User @relation(fields: [investorId], references: [id])

  @@map("investments")
}

model Lease {
  id              String    @id @default(cuid())
  propertyId      String
  landlordId      String
  tenantId        String?
  monthlyRentUSDC BigInt
  depositUSDC     BigInt
  durationMonths  Int
  contractAddress String?   @unique
  deployTxHash    String?
  status          String    @default("PENDING")
  startedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  landlord User     @relation("LandlordLeases", fields: [landlordId], references: [id])
  tenant   User?    @relation("TenantLeases",   fields: [tenantId],   references: [id])

  @@index([landlordId])
  @@index([propertyId])
  @@map("leases")
}
